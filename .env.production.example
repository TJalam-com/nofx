# Production Environment Variables
# Copy this to .env.production and fill in your values

# Render automatically provides PORT, but you can override with NOFX_BACKEND_PORT
# NOFX_BACKEND_PORT=8080

# JWT Secret (REQUIRED - Generate a strong random key)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Data Encryption Key (REQUIRED - Generate a strong random key)
DATA_ENCRYPTION_KEY=your-super-secret-encryption-key-change-this-in-production-min-32-chars

# Timezone
TZ=UTC

# Gin Mode
GIN_MODE=release

# AI Max Tokens
AI_MAX_TOKENS=4000
